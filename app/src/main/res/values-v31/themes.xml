<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+: a window's background blur is only drawn when the window is
        declared translucent in its theme; setting it at runtime is not enough.
    -->
    <style name="Theme.Hearth" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
